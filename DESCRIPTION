Package: cdid
Type: Package
Title: The Chained Difference-in-Differences
Version: 1.1.0.0
Authors@R: 
    c(
      person("David", "Benatia", email = "david.benatia@hec.ca", role = c("cre", "aut")),
      person("Christophe", "Bellégo", email = "christophe.bellego@ensae.fr", role = "aut"),
